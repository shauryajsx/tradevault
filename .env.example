# ============================================
# TRADEVAULT - Environment Variables
# ============================================
# 
# STEP 1: Rename this file from .env.example to .env.local
# STEP 2: Fill in your MongoDB URI (get free from mongodb.com/atlas)
# STEP 3: Generate a random secret (or just type any long random string)
#
# That's it! Run "npm run dev" to start.
# ============================================

# MongoDB Connection String
# Get this from: https://www.mongodb.com/atlas (free tier available)
# It looks like: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/tradevault

#MONGODB_URI=mongodb+srv://connectayushshaurya_db_user:BnVfihXF7j8Vfn2Y@trade-vault-cluster0.j7yrqyh.mongodb.net/?appName=Trade-vault-Cluster0
MONGODB_URI=mongodb+srv://connectayushshaurya_db_user:BnVfihXF7j8Vfn2Y@cluster0.j7yrqyh.mongodb.net/?retryWrites=true&w=majority

# NextAuth Secret (any random string - used to encrypt sessions)
# You can generate one at: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=77f1b19015e4a7745818f46d02ea6f49

# NextAuth URL (change to your domain when deploying)
# For local development, keep as http://localhost:3000
# For Vercel, set to your deployed URL like https://tradevault.vercel.app
NEXTAUTH_URL=tradevault-three.vercel.app
